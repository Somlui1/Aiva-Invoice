# =============================================================================
# AIVA Portal — production environment (template; the real file is NOT committed)
# The server refuses to start while anything below is missing or unsafe
# (src/server/auth/config.ts → productionConfigProblems). Check with:
#   NODE_ENV=production npx tsx scripts/check-integrations.ts --ad-user <sam> --dms <paperless id>
# =============================================================================
NODE_ENV=production
PORT=3000
HOSTNAME=0.0.0.0
TRUST_PROXY=1                       # behind the TLS reverse proxy

# --- Database ---
# Now: SQLite on a volume.  Production target: SQL Server container, e.g.
# DATABASE_URL=sqlserver://mssql:1433;database=aiva;user=aiva_app;password=...;encrypt=true;trustServerCertificate=false
DATABASE_URL=file:/app/data/aiva.db
CACHE_DIR=/app/cache

# --- Session ---
AUTH_SECRET=                        # openssl rand -hex 32   (>= 32 chars, never the template value)
AUTH_SESSION_TTL_HOURS=8
AUTH_BOOTSTRAP_ADMINS=              # sAMAccountNames that become SA on FIRST login, e.g. wajeepradit.p
                                    # everybody else must be added in the permission screen first

# --- Active Directory (ldaps only; read-only service account, NOT itsupport) ---
LDAP_URL=ldaps://dc.aapico.com:636
LDAP_BIND_DN=CN=svc-aiva,OU=ServiceAccounts,DC=aapico,DC=com
LDAP_BIND_PASSWORD=
LDAP_SEARCH_BASE=DC=aapico,DC=com
LDAP_UPN_SUFFIX=aapico.com
LDAP_CA_FILE=/run/secrets/ldap_ca.pem   # company root CA that signed the DC certificate

# --- Microsoft 365 sign-in (Microsoft Entra ID) — optional; set all or none ---
# Entra admin center → App registrations → AIVA Portal (see docs/m365-entra-sso.md)
ENTRA_TENANT_ID=                    # Directory (tenant) ID (GUID)
ENTRA_CLIENT_ID=                    # Application (client) ID
ENTRA_CLIENT_SECRET=                # Certificates & secrets → client secret VALUE (rotate before expiry)
ENTRA_REDIRECT_URI=https://aiva.aapico.com/api/auth/microsoft/callback   # must match the app's Web redirect URI

# --- Paperless-ngx (token of a READ-ONLY user) ---
PAPERLESS_URL=https://dms.aapico.com
PAPERLESS_TOKEN=
PAPERLESS_TIMEOUT_MS=10000

# --- Machine-to-machine keys (openssl rand -hex 32 each) ---
ENGINE_INGEST_KEY=                  # System A sends: Authorization: Bearer <key> on POST /api/engine/ingest
ORACLE_CALLBACK_KEY=                # AP interface sends it on POST /api/ap/batches/:id/callback

# --- Oracle (optional) ---
ORACLE_MCP_URL=
ORACLE_MCP_TOKEN=

# --- Must NOT be set in production ---
# AUTH_DEV_LOGIN, VITE_AUTH_MOCK, VITE_AUTH_BYPASS, AIVA_ENABLE_SIMULATION, LDAP_TLS_INSECURE
