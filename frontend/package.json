{
  "name": "aiva-portal",
  "private": true,
  "version": "5.11.1",
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/copy-pdfjs-worker.mjs",
    "predev": "node scripts/copy-pdfjs-worker.mjs",
    "prebuild": "node scripts/copy-pdfjs-worker.mjs",
    "dev": "concurrently -k -p \"[{name}]\" -n \"VITE,EXPRESS\" -c \"cyan,magenta\" \"vite\" \"tsx watch server/index.ts\"",
    "dev:client": "vite",
    "dev:server": "tsx watch server/index.ts",
    "build": "vite build",
    "start": "tsx server/index.ts",
    "preview": "vite preview",
    "check:services": "tsx scripts/check-services.ts",
    "check:integrations": "tsx scripts/check-integrations.ts",
    "db:reset": "tsx scripts/db-reset.ts",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "seed:engine": "tsx scripts/simulate-engine-push.ts",
    "seed:v5": "tsx scripts/seed-invoices-v5.ts",
    "backfill:findings": "tsx scripts/backfill-findings.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "concurrently": "^10.0.6",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "ldapts": "^9.2.0",
    "pdfjs-dist": "^5.7.284",
    "prisma": "^6.19.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.13.1",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^29.1.1",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "~5.7.2",
    "vite": "^6.1.0",
    "vitest": "^3.0.5"
  }
}
