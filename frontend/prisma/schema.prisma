generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Document {
  id              String   @id // e.g. "DMS-100"
  dmsDocId        String   @unique
  packageId       String
  fileSha256      String
  pageCount       Int
  invoiceNum      String
  invoiceDate     String
  companyCode     String
  supplierTaxId   String
  supplierName    String
  grandTotal      Float
  currency        String   @default("THB")
  status          String   // Auto-pass, Review, Hold, Manual Review, Confirmed, Sent, Posted, Rejected, Superseded, Import Failed
  recommendation  String
  maxSeverity     String
  receiverName    String?
  receiptNum      String?
  linesMatched    String?
  assignedRole    String   @default("EU")
  apStatus        String   @default("unconfirmed")
  confirmedBy     String?
  confirmedAt     DateTime?
  
  // Concurrency & Document Locking
  isLocked        Boolean  @default(false)
  lockedAt        DateTime?
  lockedBy        String?
  
  // Oracle AP Batch Tracking
  apBatchId       String?
  oracleInvoiceId String?
  importError     String?

  payloadJson     String   // Full Portal Document JSON (Structured)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  runs            ValidationRun[]
  bboxes          DocumentBBox[]
}

model ValidationRun {
  id              String   @id @default(cuid())
  documentId      String
  validationId    String   @unique
  correlationId   String?
  validationRound Int      @default(1)
  rawEngineResult String   // Raw JSON from engine
  completedAt     DateTime @default(now())
  document        Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
}

model DocumentBBox {
  id         String   @id @default(cuid())
  documentId String
  pageNum    Int
  boxType    String   // 'rule_evidence', 'ocr_word', 'table_cell', 'oracle_receipt'
  targetRef  String?  // e.g. 'V-01', 'item:0', 'receipt:1'
  boxJson    String   // Serialized JSON of coordinates [ymin, xmin, ymax, xmax] & metadata
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId, pageNum])
}

model AuditLog {
  id           String   @id @default(cuid())
  category     String   @default("DOCUMENT") // 'DOCUMENT' | 'INGESTION' | 'RBAC_USER' | 'RBAC_PERMISSION' | 'AUTH' | 'ORACLE_SYNC' | 'AP_BATCH'
  docId        String   @default("—")
  whoId        String?
  who          String
  role         String
  act          String
  action       String?
  fromStatus   String?
  toStatus     String?
  reason       String?
  note         String?
  detail       String
  metadataJson String?
  ipAddress    String?
  createdAt    DateTime @default(now())

  @@index([category])
  @@index([docId])
  @@index([createdAt])
}

model ApBatch {
  id          String    @id // e.g. "AP-20261014-001"
  status      String    // 'PENDING' | 'SENT' | 'SYNCED' | 'FAILED'
  totalDocs   Int
  totalAmount Float
  companyCode String
  createdBy   String
  sentAt      DateTime?
  payloadJson String    // AP Invoice & Line Interface Data
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model User {
  id          String   @id @default(cuid())
  email       String   @unique
  name        String
  samAccount  String?
  empId       String?
  unit        String?
  role        String   // 'EU' | 'ACC' | 'APR' | 'ADM'
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  companies   UserCompany[]
  receivers   UserReceiverMap[]
}

model UserCompany {
  id          String @id @default(cuid())
  userId      String
  companyCode String // 'AH', 'AHT', 'AHP', 'AM'
  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, companyCode])
}

model UserReceiverMap {
  id           String   @id @default(cuid())
  userId       String
  receiverName String
  assignedBy   String
  ticketRef    String?
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, receiverName])
}

model Company {
  code        String   @id // Short code: AH, AHP, AHT, AF, AITS, AM, AHA, AMPK, AMPT, ABC, AEV, MG, AVEE...
  name        String       // Official legal entity name
  taxId       String?      // Tax Identifier (e.g. 'TH3011706022')
  ouName      String?      // Oracle EBS Operating Unit name (e.g. 'AH - Aapico Hitech')
  ledgerName  String?      // Oracle EBS Ledger name (e.g. 'AH_Ledger')
  orgId       Int?         // Oracle Organization ID (e.g. 101, 176, 195, 413, 535)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([name])
  @@index([orgId])
}
