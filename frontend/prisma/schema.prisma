generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Document {
  id              String   @id // e.g. "DMS-100"
  dmsDocId        String   @unique
  packageId       String
  fileSha256      String
  pageCount       Int
  invoiceNum      String
  invoiceDate     String
  companyCode     String
  supplierTaxId   String
  supplierName    String
  grandTotal      Float
  currency        String   @default("THB")
  status          String   // Auto-pass, Review, Hold, Manual Review, Confirmed, Sent, Posted, Rejected, Superseded, Import Failed
  recommendation  String
  maxSeverity     String
  receiverName    String?
  receiptNum      String?
  linesMatched    String?
  assignedRole    String   @default("EU")
  apStatus        String   @default("unconfirmed")
  confirmedBy     String?
  confirmedAt     DateTime?
  
  // Concurrency & Document Locking
  isLocked        Boolean  @default(false)
  lockedAt        DateTime?
  lockedBy        String?
  
  // Oracle AP Batch Tracking
  apBatchId       String?
  oracleInvoiceId String?
  importError     String?

  // Business identity & duplicate resolution (DR-01..07).
  // `id` / `dmsDocId` stay the only technical unique keys. The business keys below are deliberately
  // NOT unique: Superseded / Duplicate documents of the same invoice must stay stored as history.
  identityStatus  String?  // RESOLVED | NOT_FOUND | UNRESOLVED (null = row written before v5.6)
  receiveId       String?  // primary business key — RESOLVED only (normalised receive_id)
  secondaryKey    String?  // normalised supplier_tax_id|invoice_num — RESOLVED / NOT_FOUND only, never UNRESOLVED
  missingKeys     String?  // JSON string[] — UNRESOLVED only
  supersedesId    String?  // the older document this one replaced (DR-01 / DR-02)
  supersededById  String?  // the newer document that replaced this one
  duplicateOfId   String?  // the current document this one duplicates (DR-03 / DR-04)
  drRule          String?  // DR rule applied when this row was ingested
  drMatchedBy     String?  // RECEIVE_ID | SECONDARY_KEY

  payloadJson     String   // Full Portal Document JSON (Structured)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  runs            ValidationRun[]
  bboxes          DocumentBBox[]

  @@index([receiveId])
  @@index([secondaryKey])
}

model ValidationRun {
  id              String   @id @default(cuid())
  documentId      String
  validationId    String   @unique
  correlationId   String?
  validationRound Int      @default(1)
  rawEngineResult String   // Raw JSON from engine
  completedAt     DateTime @default(now())
  document        Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
}

model DocumentBBox {
  id         String   @id @default(cuid())
  documentId String
  pageNum    Int
  boxType    String   // 'rule_evidence', 'ocr_word', 'table_cell', 'oracle_receipt'
  targetRef  String?  // e.g. 'V-01', 'item:0', 'receipt:1'
  boxJson    String   // Serialized JSON of coordinates [ymin, xmin, ymax, xmax] & metadata
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId, pageNum])
}

model AuditLog {
  id         String   @id @default(cuid())
  docId      String
  whoId      String?
  who        String
  role       String
  act        String
  action     String?
  fromStatus String?
  toStatus   String?
  reason     String?
  note       String?
  detail     String
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([docId])
  @@index([createdAt])
}

model ApBatch {
  id          String    @id // e.g. "AP-20261014-001"
  status      String    // 'PENDING' | 'SENT' | 'SYNCED' | 'FAILED'
  totalDocs   Int
  totalAmount Float
  companyCode String
  createdBy   String
  sentAt      DateTime?
  payloadJson String    // AP Invoice & Line Interface Data
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model User {
  id          String   @id @default(cuid())
  email       String   @unique
  name        String
  samAccount  String?
  empId       String?
  unit        String?
  role        String   // 'EU' | 'ACC' | 'APR' | 'ADM'
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  companies   UserCompany[]
  receivers   UserReceiverMap[]
}

model UserCompany {
  id          String @id @default(cuid())
  userId      String
  companyCode String // 'AH', 'AHT', 'AHP', 'AM'
  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, companyCode])
}

model UserReceiverMap {
  id           String   @id @default(cuid())
  userId       String
  receiverName String
  assignedBy   String
  ticketRef    String?
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, receiverName])
}

/// v5.13 — master บริษัทในเครือ (sync จาก Oracle ERP / นำเข้า JSON)
/// ว่าง = ใช้ค่าในโค้ด (src/mock/companies.ts) · บริษัท "?" ไม่อยู่ในตารางนี้
/// status: active = ใช้จับคู่ Tax ID / ORG_ID และมอบหมายผู้ใช้ได้ · pending = พบใน Oracle แต่ยังไม่ได้ตั้งรหัส
model Company {
  code      String    @id                   // 'AH', 'AHT' … (pending = 'PENDING-<tax>')
  name      String
  tax       String    @unique               // เลขประจำตัวผู้เสียภาษี 13 หลัก (ตัวเลขล้วน)
  orgsJson  String    @default("[]")        // [{ "id": 103, "name": "APD" }]
  status    String    @default("active")    // active | pending
  source    String    @default("builtin")   // builtin | oracle_mcp | import
  oracleName String?                        // ชื่อนิติบุคคลตาม Oracle (อ้างอิง)
  syncedAt  DateTime?
  updatedAt DateTime  @updatedAt
}
