# Prisma / Portal database (relative paths resolve against prisma/)
DATABASE_URL="file:./dev.db"

# --- DMS (Paperless-NGX) PDF proxy: GET /api/documents/:id/pdf ---
# Names match the Engine's own reader so one .env serves both sides.
# The shorter PAPERLESS_URL / PAPERLESS_TOKEN aliases are also accepted.
PAPERLESS_BASE_URL=""
PAPERLESS_API_TOKEN=""
# Optional: upstream timeout in ms (default 10000).
PAPERLESS_TIMEOUT_MS="10000"
# Optional: directory of already-downloaded scans used as the offline fallback.
# Default is the Engine's cache: ../engine/.cache/downloads
PDF_CACHE_DIR=""

# ==============================================================================
# Authentication & Identity Provider (LDAP & Microsoft 365 / OAuth)
# ==============================================================================
NEXT_PUBLIC_AUTH_MOCK="true"
NEXT_PUBLIC_AUTH_BYPASS="true"
NEXT_PUBLIC_SUPPORT_URL=""

# Active Directory / LDAP Service Bind Credentials
LDAP_URL="ldaps://dc.aapico.com:636"
LDAP_BIND_DN="CN=svc-aiva,OU=ServiceAccounts,DC=aapico,DC=com"
LDAP_BIND_PASSWORD=""
LDAP_SEARCH_BASE="DC=aapico,DC=com"
LDAP_SEARCH_FILTER="(sAMAccountName={{username}})"
LDAP_GROUP_BASE="OU=Groups,DC=aapico,DC=com"

# Microsoft 365 / Entra ID (Azure AD) OAuth 2.0 / OIDC
AZURE_AD_CLIENT_ID=""
AZURE_AD_CLIENT_SECRET=""
AZURE_AD_TENANT_ID=""
AZURE_AD_REDIRECT_URI="http://localhost:3000/api/auth/microsoft/callback"
AUTH_SECRET="aiva-super-secret-session-key-change-in-production"
