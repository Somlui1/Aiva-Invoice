# =============================================================================
# AIVA Portal — ONE settings file for both ways of running:
#
#   npm run build && npm start     reads this file directly (server/index.ts)
#   docker compose up -d --build   reads this file too (env_file) and overrides only:
#                                  NODE_ENV=production, DATABASE_URL (its own volume), LDAP_CA_FILE,
#                                  PORT inside the container, and turns dev logins / sample data off.
#
# Copy to .env and fill in. Never commit .env (it is in .gitignore / .dockerignore).
# =============================================================================

# --- npm start ---------------------------------------------------------------
PORT=3000
# Relative paths resolve against prisma/ (file:./dev.db = prisma/dev.db). Docker ignores this line.
DATABASE_URL="file:./dev.db"
# Leave empty for development; `npm start` in production mode: NODE_ENV=production
# NODE_ENV=production

# --- docker compose (host side) ----------------------------------------------
# Host port of the container (different from PORT so both can run at once)
AIVA_DOCKER_PORT=3001
# 0.0.0.0 = reachable from the LAN · 127.0.0.1 = only a reverse proxy on this machine
AIVA_DOCKER_BIND=0.0.0.0
# CA of the domain controllers (mounted into the container as a secret)
LDAP_CA_FILE_HOST=./secrets/ldap_ca.pem
# 0 = users connect directly · 1 = behind one reverse proxy (TLS)
TRUST_PROXY=0
# auto = Secure cookie only over HTTPS · true = always (set once the site is served over HTTPS)
COOKIE_SECURE=auto

# --- Session ------------------------------------------------------------------
# Required in production, ≥ 32 characters:  openssl rand -hex 32
AUTH_SECRET=""
AUTH_SESSION_TTL_HOURS=8
# First Super Admins (AD sAMAccountName, comma separated) — created on their first sign-in
AUTH_BOOTSTRAP_ADMINS=""

# --- Development only (ignored / forced off in the container) ------------------
AUTH_DEV_LOGIN="false"
VITE_AUTH_MOCK="false"
VITE_AUTH_BYPASS="false"
AIVA_SEED_SAMPLE="false"

# --- Active Directory (ldaps:// required in production) ------------------------
LDAP_URL=""
LDAP_BIND_DN=""
LDAP_BIND_PASSWORD=""
LDAP_SEARCH_BASE="DC=aapico,DC=com"
LDAP_UPN_SUFFIX="aapico.com"
# npm start: path to the CA file on this machine (the container uses LDAP_CA_FILE_HOST above)
LDAP_CA_FILE=""
ALLOW_ITSUPPORT_BIND="false"

# --- Microsoft 365 / Entra ID (optional: all four or none) --------------------
ENTRA_TENANT_ID=""
ENTRA_CLIENT_ID=""
ENTRA_CLIENT_SECRET=""
ENTRA_REDIRECT_URI=""

# --- Paperless (read-only token) ------------------------------------------------
PAPERLESS_URL=""
PAPERLESS_TOKEN=""
PAPERLESS_TIMEOUT_MS=10000
# npm start only: folder of already downloaded scans (offline fallback)
PDF_CACHE_DIR=""

# --- Machine keys --------------------------------------------------------------
# System A / n8n → POST /api/engine/ingest
ENGINE_INGEST_KEY=""
# Oracle AP interface → POST /api/ap/batches/:id/callback
ORACLE_CALLBACK_KEY=""

# --- Oracle ----------------------------------------------------------------------
ORACLE_MCP_URL=""
ORACLE_MCP_TOKEN=""
# ผูกใบรับ: Oracle API (GET {url}/receipts?supplier_tax_id=&invoice_num= · GET {url}/po/{po}/suppliers)
RECEIPT_LOOKUP_URL=""
RECEIPT_LOOKUP_KEY=""
# Dev / UAT stand-in instead of the API (example: docs/receipt-lookup.fixture.example.json)
RECEIPT_LOOKUP_FIXTURE=""

# --- Real-time (v5.12) -------------------------------------------------------------
# Seconds between keep-alive pings on /api/events (proxies close idle streams)
EVENTS_PING_SEC=25
