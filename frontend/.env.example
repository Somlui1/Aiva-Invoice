# =============================================================================
# AIVA Portal — local development (.env, not committed)
# =============================================================================
# Prisma / Portal database (relative paths resolve against prisma/)
DATABASE_URL="file:./dev.db"

# --- Development login ---
# The API accepts only a signed session cookie. With AUTH_DEV_LOGIN=true the mock login page gets one
# from POST /api/auth/dev-login, and the offline AD passwords work. Ignored when NODE_ENV=production.
AUTH_DEV_LOGIN="true"
# Optional: sessions survive a server restart only with a fixed secret
AUTH_SECRET=""
# Vite (browser) flags — dev server only; `vite build` always turns them off
VITE_AUTH_MOCK="true"
VITE_AUTH_BYPASS="true"
# Sample invoices from temp/ fill an EMPTY dev database at start-up (false = start empty)
AIVA_SEED_SAMPLE="true"

# --- DMS (Paperless-NGX) PDF proxy: GET /api/documents/:id/pdf ---
PAPERLESS_URL=""
PAPERLESS_TOKEN=""
PAPERLESS_TIMEOUT_MS="10000"
# Optional: directory of already-downloaded scans used as the offline fallback.
# Default is the Engine's cache: ../engine/.cache/downloads
PDF_CACHE_DIR=""

# --- Active Directory (optional in dev; empty = offline login via AUTH_DEV_LOGIN) ---
LDAP_URL=""
LDAP_BIND_DN=""
LDAP_BIND_PASSWORD=""
LDAP_SEARCH_BASE="DC=aapico,DC=com"
LDAP_UPN_SUFFIX="aapico.com"
LDAP_CA_FILE=""
# Dev / staging only, when the DC certificate is not trusted yet (refused in production)
LDAP_TLS_INSECURE=""

# --- Machine keys (empty in dev = open) ---
ENGINE_INGEST_KEY=""
ORACLE_CALLBACK_KEY=""
