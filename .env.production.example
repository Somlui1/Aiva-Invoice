# =============================================================================
# AIVA Production Environment Configuration Template
# =============================================================================

# --- Web Portal (Frontend) ---
NODE_ENV=production
PORT=3000
HOSTNAME=0.0.0.0
DATABASE_URL=file:/app/data/aiva.db
CACHE_DIR=/app/cache

# --- Authentication & LDAP / Active Directory ---
# Set to false in production to enforce real Active Directory authentication
NEXT_PUBLIC_AUTH_MOCK=false
NEXT_PUBLIC_AUTH_BYPASS=false

# Active Directory / LDAP Server
LDAP_URL=ldaps://dc.aapico.com:636
LDAP_BIND_DN=CN=svc-aiva,OU=ServiceAccounts,DC=aapico,DC=com
LDAP_BIND_PASSWORD=YourSuperSecretPasswordHere
LDAP_SEARCH_BASE=DC=aapico,DC=com

# Session Security Secret (Generate a strong random string: openssl rand -hex 32)
AUTH_SECRET=your-production-secret-key-replace-this-min-32-chars

# --- Engine Integration ---
SYSTEM_A_URL=http://engine:8080
TEST_PORTAL_URL=http://frontend:3000

# --- Oracle Integration (Optional / Production ORDS) ---
ORACLE_REST_BASE=https://oracle.aapico.com/ords/aiva
ORACLE_CLIENT_ID=your-oracle-client-id
ORACLE_CLIENT_SECRET=your-oracle-client-secret
